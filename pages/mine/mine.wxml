<view class="mine-container">
  <view class="user-header">
    <t-avatar size="160rpx" image="{{userInfo.avatar}}" shape="circle" />
    <text class="user-name">{{userInfo.name || '未设置'}}</text>
  </view>
  
  <view class="menu-section">
    <t-cell-group theme="card">
      <t-cell title="基本信息" arrow hover bindtap="goToProfile" t-class-left-icon="cell-icon">
        <t-icon slot="left-icon" name="personal-information" size="48rpx" />
      </t-cell>
      <t-cell title="我的爆料" arrow hover>
        <t-icon slot="left-icon" name="loudspeaker" size="48rpx" />
      </t-cell>
      <t-cell title="我的收藏" arrow hover>
        <t-icon slot="left-icon" name="star" size="48rpx" />
      </t-cell>
      <t-cell title="免责声明" arrow hover>
        <t-icon slot="left-icon" name="error-circle" size="48rpx" />
      </t-cell>
      <t-cell title="隐私" arrow hover>
        <t-icon slot="left-icon" name="lock-on" size="48rpx" />
      </t-cell>
    </t-cell-group>
  </view>
</view>