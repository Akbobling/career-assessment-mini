.page {
  min-height: 100vh;
  background-color: #F0F9FF;
  padding: 32rpx 24rpx 200rpx;
}

.result-header {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.result-label {
  font-size: 28rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
}

.result-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E3A8A;
  line-height: 1.4;
}

.result-bank {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 12rpx;
}

.chart-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E3A8A;
  margin-bottom: 28rpx;
}

.chart-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bar-label {
  width: 80rpx;
  font-size: 22rpx;
  color: #6b7280;
  text-align: right;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 32rpx;
  background: #E0E7FF;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #3B82F6;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.bar-fill-top {
  background: linear-gradient(90deg, #3B82F6 0%, #1E3A8A 100%);
}

.bar-score {
  width: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1E3A8A;
  text-align: right;
  flex-shrink: 0;
}

.detail-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E3A8A;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F9FF;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-name {
  font-size: 26rpx;
  color: #000000;
  flex: 1;
  margin-right: 16rpx;
}

.detail-score-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.detail-score {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E3A8A;
}

.detail-var {
  font-size: 22rpx;
  color: #9CA3AF;
}

.back-btn {
  position: fixed;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #1E3A8A;
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 138, 0.3);
  transition: all 0.2s ease;
}

.back-btn:active {
  opacity: 0.8;
  transform: translateX(-50%) scale(0.95);
}

.back-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}
