<view class="page">
  <view class="result-header">
    <view class="result-label">您的结果是</view>
    <view class="result-name">{{topCategory}}</view>
  </view>

  <view class="chart-card">
    <view class="chart-title">{{quizType === 'major' ? '各大类得分对比' : '各中类得分对比'}}</view>
    <view class="chart-body">
      <view class="bar-row" wx:for="{{chartData}}" wx:key="label">
        <view class="bar-label">{{item.label}}</view>
        <view class="bar-track">
          <view class="bar-fill {{item.isTop ? 'bar-fill-top' : ''}}" style="width: {{item.percent}}%;"></view>
        </view>
        <view class="bar-score">{{item.score}}</view>
      </view>
    </view>
  </view>

  <view class="detail-card">
    <view class="detail-title">详细得分</view>
    <view class="detail-row" wx:for="{{chartData}}" wx:key="label">
      <view class="detail-name">{{item.fullLabel}}</view>
      <view class="detail-score-wrap">
        <view class="detail-score">{{item.score}} / {{item.maxScore}}</view>
        <view class="detail-var">方差: {{item.variance}}</view>
      </view>
    </view>
  </view>

  <view class="back-btn" bindtap="goBack">
    <t-icon name="chevron-left" size="20px" color="#ffffff" />
    <text class="back-text">返回首页</text>
  </view>
</view>
