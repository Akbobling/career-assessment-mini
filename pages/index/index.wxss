/**index.wxss**/
page {
  background: #f0f9ff;
}

.container {
  padding: 80rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1e3a8a;
}

.entry-card {
  width: 85%;
  background: #ffffff;
  border: 2rpx solid #1e3a8a;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-card-done {
  border-color: #22C55E;
  opacity: 0.85;
}

.entry-info {
  flex: 1;
}

.entry-name {
  font-size: 34rpx;
  color: #1e3a8a;
  font-weight: 600;
}

.entry-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.entry-done {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.entry-done-text {
  font-size: 26rpx;
  color: #22C55E;
  font-weight: 600;
}

.result-section {
  width: 85%;
  background: #ffffff;
  border: 2rpx solid #3B82F6;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.result-empty {
  border-style: dashed;
  border-color: #9CA3AF;
}

.result-tip {
  font-size: 28rpx;
  color: #1E3A8A;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.result-tip-empty {
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.result-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  border-radius: 999rpx;
  border: 2rpx solid #3B82F6;
  background: #ffffff;
  transition: all 0.2s ease;
}

.result-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.result-btn-primary {
  background: #1E3A8A;
  border-color: #1E3A8A;
}

.result-btn-text {
  font-size: 28rpx;
  color: #1E3A8A;
  font-weight: 500;
}

.result-btn-text-light {
  color: #ffffff;
}
