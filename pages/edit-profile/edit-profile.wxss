.edit-container {
  padding: 30rpx;
}

.edit-item {
  margin-bottom: 40rpx;
}

.edit-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.avatar-btn {
  margin-top: 40rpx;
  width: 80%;
}

.wechat-avatar-btn {
  margin-top: 24rpx;
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07C160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  border: none;
}

.wechat-avatar-btn::after {
  border: none;
}

.edit-school {
  padding: 20rpx 0;
}

.search-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.search-loading text {
  margin-left: 16rpx;
}

.university-list {
  margin-top: 20rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.search-empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}