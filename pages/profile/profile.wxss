.profile-container {
  padding: 20rpx;
}

.tip-text {
  text-align: center;
  padding: 30rpx 0;
  color: #666;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.refresh-section {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.text-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  color: #fff;
  font-weight: bold;
}

.text-avatar-small {
  width: 80rpx;
  height: 80rpx;
  font-size: 28rpx;
}